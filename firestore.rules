rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: any signed-in user (anonymous auth counts) ──────────────────
    function signedIn() {
      return request.auth != null;
    }

    // ── Helper: the request is from the document owner ──────────────────────
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasOnlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // READ-ONLY relay collections — public read, server-only writes
    // (the relay uses Firebase Admin SDK which bypasses these rules)
    // ═══════════════════════════════════════════════════════════════════════

    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;  // relay only
    }

    match /standings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    match /bracket/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /lineups/{matchId} {
      allow read: if true;
      // Clients may write compact lineup data fetched from BSD/SDB as a
      // crowd-cache, but only to the expected fields and bounded list sizes.
      allow create, update: if signedIn()
        && hasOnlyKeys([
          'flatLineups',
          'homeFormation',
          'awayFormation',
          'homeCoach',
          'awayCoach',
          'fetchedAt',
          'source'
        ])
        && request.resource.data.flatLineups is list
        && request.resource.data.flatLineups.size() <= 60
        && (!('source' in request.resource.data) ||
            request.resource.data.source in ['client', 'bsd_v2', 'sportsdb'])
        && (!('fetchedAt' in request.resource.data) ||
            request.resource.data.fetchedAt == request.time);
      allow delete: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // User prediction data — owner-only read/write
    // ═══════════════════════════════════════════════════════════════════════

    match /predictions/{uid} {
      allow read, write: if isOwner(uid);

      match /matches/{matchId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Community aggregated stats — any user can read; authenticated users
    // can increment their vote (FieldValue.increment is the write pattern).
    // ═══════════════════════════════════════════════════════════════════════

    match /match_predictions/{matchKey} {
      allow read: if true;
      allow create: if signedIn()
        && hasOnlyKeys([
          'total',
          'home',
          'draw',
          'away',
          'matchKey',
          'homeTla',
          'awayTla'
        ])
        && request.resource.data.matchKey == matchKey
        && isNonNegativeInt(request.resource.data.total)
        && isNonNegativeInt(request.resource.data.home)
        && isNonNegativeInt(request.resource.data.draw)
        && isNonNegativeInt(request.resource.data.away)
        && request.resource.data.total ==
            request.resource.data.home +
            request.resource.data.draw +
            request.resource.data.away;
      allow update: if signedIn()
        && hasOnlyKeys([
          'total',
          'home',
          'draw',
          'away',
          'matchKey',
          'homeTla',
          'awayTla'
        ])
        && request.resource.data.matchKey == matchKey
        && request.resource.data.matchKey == resource.data.matchKey
        && request.resource.data.homeTla == resource.data.homeTla
        && request.resource.data.awayTla == resource.data.awayTla
        && isNonNegativeInt(request.resource.data.total)
        && isNonNegativeInt(request.resource.data.home)
        && isNonNegativeInt(request.resource.data.draw)
        && isNonNegativeInt(request.resource.data.away)
        && request.resource.data.total ==
            request.resource.data.home +
            request.resource.data.draw +
            request.resource.data.away
        && request.resource.data.total == resource.data.total + 1;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Leaderboard — public read (anyone can see rankings);
    // users can only write their OWN leaderboard doc.
    // ═══════════════════════════════════════════════════════════════════════

    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Trivia stats — owner-only
    // ═══════════════════════════════════════════════════════════════════════

    match /trivia/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Deny everything else
    // ═══════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
